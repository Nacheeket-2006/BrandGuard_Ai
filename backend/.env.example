# Local demonstration defaults; no paid services required.
DEMO_MODE=true
AI_MODE=offline
ALLOW_REGISTRATION=false
DATABASE_URL=sqlite:///backend/brandguard.db
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5173,http://localhost:5173

# Live AI: set AI_MODE=live, then supply a key on the server.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Before an internet-facing deployment, use DEMO_MODE=false and HTTPS.
# Local DEMO_MODE=true permits creator registration. In authenticated production,
# set ALLOW_REGISTRATION=true only when self-service creator access is intended.
# Generate SESSION_SECRET and BRANDGUARD_USERS using scripts/configure_users.py.
SESSION_SECRET=
BRANDGUARD_USERS={}
