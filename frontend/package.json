{
  "name": "brandguard-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write \"*.{ts,tsx,css,html,json,md}\" \"public/*.js\" \"shared/*.json\"",
    "format:check": "prettier --check \"*.{ts,tsx,css,html,json,md}\" \"public/*.js\" \"shared/*.json\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "diff": "^9.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  }
}
